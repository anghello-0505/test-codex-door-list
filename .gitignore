# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Supabase local project metadata
supabase/.temp/

# local modules configuration
.modules

# vercel
.vercel

# Project skills are shared with the repository. Ignore other local agent state.
/.codex/*
!/.codex/config.toml
!/.codex/skills/
!/.codex/hooks.json
!/.codex/agents/
/.codex/agents/*
!/.codex/agents/door_accessibility.toml
!/.codex/agents/ticket_email.toml
!/.codex/agents/end_to_end.toml
/.codex/skills/*
!/.codex/skills/door-list-ui/
!/.codex/skills/door-list-ui/**
!/.codex/skills/impeccable/
!/.codex/skills/impeccable/**

# Codex discovery entries delegate to the canonical skills in .codex/skills.
/.agents/*
!/.agents/skills/
/.agents/skills/*
!/.agents/skills/door-list-ui/
!/.agents/skills/impeccable/
/.agents/skills/door-list-ui/*
!/.agents/skills/door-list-ui/SKILL.md
/.agents/skills/impeccable/*
!/.agents/skills/impeccable/SKILL.md

# Generated design-review state stays local.
.impeccable/

# typescript
*.tsbuildinfo
next-env.d.ts
